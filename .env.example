# Apex Hub Environment Configuration

# Django
SECRET_KEY=change-me-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,hungrily-throttle-nintendo.ngrok-free.dev
DJANGO_SETTINGS_MODULE=apex_hub.settings

# Database
POSTGRES_DB=apex_hub
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=emmie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:emmie@localhost:5432/apex_hub

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (keep local origins; add your ngrok HTTPS URL when sharing externally)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hungrily-throttle-nintendo.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=https://hungrily-throttle-nintendo.ngrok-free.dev
NGROK_DOMAIN=hungrily-throttle-nintendo.ngrok-free.dev
PUBLIC_APP_URL=https://hungrily-throttle-nintendo.ngrok-free.dev
TRUST_PROXY_HEADERS=True

# Email (Gmail SMTP — use an app password, not your account password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-account@gmail.com

# Broadcast integrations (email / SMS / WhatsApp)
# Set true when SMTP or provider credentials are configured.
INTEGRATION_LIVE_DISPATCH=False

# Frontend (use /api/v1 so Vite proxies to Django — required for ngrok HTTPS tunnels)
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY=http://localhost:8000
VITE_APP_NAME=Apex Hub
VITE_APP_TAGLINE=The Easy Way

# Platform
PLATFORM_NAME=Apex Hub
PLATFORM_TAGLINE=The Easy Way
MAINTENANCE_MODE=False

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Payment Gateways (placeholders)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
PESAPAL_CONSUMER_KEY=